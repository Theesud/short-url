    GW["API Gateway<br/>ตรวจ JWT · Rate Limit · Routing"]

    subgraph SVC["Services (แยก deploy และ scale ได้)"]
        AUTH["Auth Service<br/>สมัคร · เข้าสู่ระบบ · JWT"]
        URLS["URL Service<br/>สร้าง · ลบ · รายการลิงก์"]
        RED["Redirect Service<br/>อ่านเร็ว · ใช้ Cache"]
        ANA["Analytics Service<br/>รวมและให้บริการสถิติ"]
    end

    CACHE[("Redis Cache<br/>code → URL, วันหมดอายุ")]
    MQ{{"Message Queue<br/>Redis Streams / BullMQ"}}
    DB1[("Users DB")]
    DB2[("URLs DB")]
    DB3[("Analytics DB<br/>คลิก + สำเนา code/เจ้าของ")]

    B -->|"โหลดหน้าเว็บ"| FE
    B -->|"REST API + JWT"| GW
    GW --> AUTH
    GW --> URLS
    GW --> ANA
    B -->|"เปิด Short URL<br/>(กดลิงก์ / สแกน QR)"| RED

    AUTH --> DB1
    URLS --> DB2
